	local b=U.Button(c.Frame,o.Name or &apos;Button&apos;,t); b.AnchorPoint=Vector2.new(.5,.5); b.Position=UDim2.fromScale(.5,.5); b.Size=UDim2.new(1,0,0,40); U.Stroke(b,t.Border); U.Hover(w,b)
