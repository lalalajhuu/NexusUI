end
function Elements.Dropdown(tab,o)
	o=o or {}; local c,w,t=base(tab,o,128); local values={}; local opened=false
	local b=U.Button(c.Frame,&apos;Select&apos;,t); b.AnchorPoint=Vector2.new(.5,.5); b.Position=UDim2.new(.5,0,0,57); b.Size=UDim2.new(1,0,0,42); b.TextXAlignment=Enum.TextXAlignment.Left
